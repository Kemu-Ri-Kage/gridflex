# Copy this file to .env and paste your real key in.
# .env is in .gitignore and must never be committed.
GRIDSTATUS_API_KEY=paste_your_key_here

# Oracle publication. Prefer the encrypted keystore path; the password is
# requested interactively and must never be stored here. REPORTER_PRIVATE_KEY
# is supported as an alternative but should never be committed or shared.
REPORTER_KEYSTORE_PATH=/absolute/path/to/encrypted/keystore
# REPORTER_PRIVATE_KEY=0x...
XLAYER_RPC_URL=https://testrpc.xlayer.tech/terigon

# Solidity deployment (X Layer testnet only).
# Public address of the encrypted Foundry keystore account used with --account.
DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000
# Optional. If omitted, the deployer wallet is also the oracle reporter.
REPORTER_ADDRESS=0x0000000000000000000000000000000000000000
# Normal testnet value is 3600. Use 0 only for the rehearsed past-day demo.
ORACLE_DISPUTE_WINDOW=3600

# Fill these public deployment values before running CreateDemoMarket.s.sol.
GRID_ORACLE_ADDRESS=0x0000000000000000000000000000000000000000
MARKET_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
MOCK_USDT_ADDRESS=0x0000000000000000000000000000000000000000
MARKET_METRIC_ID=ERCOT_HBNORTH_DA_AVG
MARKET_DAY_KEY=20260908
MARKET_THRESHOLD=3000
MARKET_RESOLVE_AFTER=0
# Grace period before cancel() is available. Use 0 for a past-day demo market.
MARKET_DISPUTE_WINDOW=0
# 10,000 MockUSDT with 6 decimals.
INITIAL_LIQUIDITY=10000000000
